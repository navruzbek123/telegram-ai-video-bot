    {
      "parameters": {
        "jsCode": "const aiOutput = $input.item.json.output; if (!aiOutput) { throw new Error(\"No output\"); } let jsonString = aiOutput; jsonString = jsonString.replace(/```json\\s*/g, \"\").replace(/```\\s*/g, \"\"); const jsonMatch = jsonString.match(/\\{[\\s\\S]*\\}/); if (jsonMatch) { jsonString = jsonMatch[0]; } try { const parsed = JSON.parse(jsonString); if (!parsed.videoPrompt || !parsed.socialMediaText) { throw new Error(\"Missing fields\"); } return { videoPrompt: parsed.videoPrompt, socialMediaText: parsed.socialMediaText }; } catch (error) { const videoPromptMatch = aiOutput.match(/videoPrompt[\"']?\\s*:\\s*[\"']([^\"']+)[\"']/i); const socialMediaTextMatch = aiOutput.match(/socialMediaText[\"']?\\s*:\\s*[\"']([^\"']+)[\"']/i); if (videoPromptMatch && socialMediaTextMatch) { return { videoPrompt: videoPromptMatch[1], socialMediaText: socialMediaTextMatch[1] }; } throw new Error(\"Failed to parse\"); }"
      },
